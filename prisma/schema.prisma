// Multi-Celebrity Fan Card Platform
// Schema is designed so any number of celebrities can be added
// without changing the application code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl= env("MIGRATION_DATABASE_URL")
}

// A community for one celebrity. One celebrity = one community.
model Celebrity {
  id             String            @id @default(cuid())
  slug           String            @unique
  // Canonical, case/space/punctuation-insensitive lookup key for duplicate
  // prevention. "Tom Cruise", "tom cruise", " TOM   CRUISE! " all normalize to
  // the same value, so the same celebrity can never be added twice.
  nameKey        String            @unique
  name           String
  category       String            // Actor | Musician | Athlete | Creator | Public Figure | Artist
  country        String
  city           String?
  profession     String
  googleInfo     String?            // cached JSON from Wikipedia/Wikidata (age, works, overview, images — the Google-style knowledge panel)
  profileImage   String?           // URL or data URI
  // SHA-256 of the uploaded profile/cover image bytes. Unique so the exact same
  // image file can never be stored twice (NULL = auto-generated/storage-less).
  profileImageHash String?          @unique
  coverImage     String?           // URL or data URI
  coverImageHash String?           @unique
  accentColor    String            @default("#8b5cf6")
  isFeatured     Boolean           @default(false)
  isActive       Boolean           @default(true)
  isVerified     Boolean           @default(false) // auto-verified for every published celebrity (social-style blue badge on the name line)
  socialLinks    String?           // legacy JSON string; new canonical links live in the 4 columns below
  // Permanent verified official platform links (source of truth). Never
  // guessed, never fan pages. Leave null when unverified — the AI scan fills
  // these for every new celebrity via identify -> research -> verify -> save.
  facebookUrl    String?
  instagramUrl   String?
  tiktokUrl      String?
  googleUrl      String?           // verified Google presence / Knowledge Panel result
  cardDesign     String?           // JSON string for this celebrity's fan-card design
  website        String?
  instagramFollowers Int?          // public follower counts, admin-editable
  tiktokFollowers    Int?
  facebookFollowers  Int?
  followersUpdatedAt DateTime?
  socialAutoPost  Boolean         @default(true) // eligible for automatic social posting
  displayFanCount Int?            @unique // auto-assigned Registered Fans figure (unique per celebrity, never shared)
  // Chat presence + account-type for this celebrity's chat room.
  chatAccountType String         @default("TEAM") // OFFICIAL | TEAM | SYSTEM
  chatAccountLabel String?       // optional "About" line shown above the chat input
  chatLastSeenAt  DateTime?      // last activity by the authorized team (drives online/offline)
  fans           FanCard[]
  memberships    MembershipLevel[]
  payments       Payment[]
  events         CelebrityEvent[]
  socialArticles SocialArticle[]
  announcements  EmailAnnouncement[]
  chatSelections FanCelebritySelection[]
  chatConversations ChatConversation[]
  chatBlocks     ChatBlock[]
  calls          ChatCall[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

@@index([category])
  @@index([country])
  @@index([isActive])
  @@index([name])
}

// Membership tiers offered by a celebrity's community.
model MembershipLevel {
  id          String      @id @default(cuid())
  celebrityId String
  celebrity   Celebrity   @relation(fields: [celebrityId], references: [id], onDelete: Cascade)
  name        String
  description String?
  benefits    String?
  price       Float?
  currency    String      @default("USD")
  displayOrder Int        @default(0)
  isActive    Boolean     @default(true)
  socialAutoPost Boolean  @default(true) // eligible for automatic social posting
  cards       FanCard[]
  payments    Payment[]

  @@index([celebrityId])
}

// A registered fan account. One account can safely own many cards
// (one per celebrity community) thanks to the FanCard links below.
model Fan {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String?   // hashed, required for dashboard login
  phone     String?
  country   String?
  isActive  Boolean   @default(true)

  // Email verification + notification preferences. Transactional emails
  // (account, security, payment confirmations) are always sent; every other
  // category can be switched off from /account or via the one-click
  // unsubscribe link in the footer of every promotional email.
  emailVerified        Boolean   @default(false)
  emailVerifiedAt      DateTime?
  notifyNewCelebrities Boolean   @default(true) // "New celebrity added" announcements
  notifyUpdates        Boolean   @default(true) // important platform updates
  notifyCommunity      Boolean   @default(true) // community/news updates
  notifyPromotions     Boolean   @default(true) // optional promotional/marketing
  unsubscribedAt       DateTime?

  // Fan last activity — drives "online / last seen" in chat (no raw location/device data).
  lastSeenAt                 DateTime?
  // "Choose Your Celebrities" onboarding: true once the picker was shown & saved (or skipped).
  onboardingCelebritiesDone  Boolean   @default(false)
  // Chat notification preference (in-app + email for new messages).
  chatNotify                 Boolean   @default(true)

  cards        FanCard[]
  payments     Payment[]
  ticketOrders TicketOrder[]
  emailMessages EmailMessage[]
  emailVerifications EmailVerificationToken[]
  chatSelections FanCelebritySelection[]
  chatConversations ChatConversation[]
  chatMessages  ChatMessage[]
  chatBlocks    ChatBlock[]
  messageReports MessageReport[]
  pushSubscriptions PushSubscription[]
  chatCalls     ChatCall[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// A WebRTC voice/video call between a fan and the celebrity's team, together
// with its signaling transcript (offers/answers/ICE). Signaling is stored in the
// DB and polled by clients (works behind the SSE shim / proxy-less deploys).
model ChatCall {
  id             String    @id @default(cuid())
  conversationId String
  celebrityId    String
  fanId          String?
  mode           String    @default("voice") // voice | video
  status         String    @default("RINGING") // RINGING | ACTIVE | ENDED | MISSED | DECLINED
  createdBy      String    @default("fan") // fan | team
  endedAt        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  celebrity    Celebrity         @relation(fields: [celebrityId], references: [id], onDelete: Cascade)
  fan          Fan?              @relation(fields: [fanId], references: [id], onDelete: SetNull)
  signals      ChatCallSignal[]

  @@index([conversationId, createdAt])
}

model ChatCallSignal {
  id        String   @id @default(cuid())
  callId    String
  from      String   // fan | team
  type      String   // offer | answer | ice | cancel | reject | end
  payload   String?  // JSON-encoded SDP or ICE candidate
  createdAt DateTime @default(now())

  call ChatCall @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId, createdAt])
}

// A fan's Web Push subscription (desktop/PWA installs). Native push is used to
// deliver chat messages while the fan is offline. Android's Capacitor wrapper
// uses FCM instead (see docs); subscriptions here cover the browser/PWA path.
model PushSubscription {
  id        String    @id @default(cuid())
  fanId     String
  endpoint  String    @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  fan Fan @relation(fields: [fanId], references: [id], onDelete: Cascade)

  @@index([fanId])
}

// A membership card issued to a fan under a specific celebrity.
// fanId + celebrityId always keeps a card attached to the right community.
model FanCard {
  id                String            @id @default(cuid())
  fanNumber         String            @unique // e.g. FC-000001 (globally unique)
  fanId             String
  celebrityId       String
  membershipLevelId String?
  fan               Fan               @relation(fields: [fanId], references: [id], onDelete: Cascade)
  celebrity         Celebrity         @relation(fields: [celebrityId], references: [id], onDelete: Cascade)
  membershipLevel   MembershipLevel?  @relation(fields: [membershipLevelId], references: [id], onDelete: SetNull)
  status            String            @default("ACTIVE") // ACTIVE | SUSPENDED | EXPIRED
  cardUrl           String?
  qrCode            String?           // data URI
  registeredAt      DateTime          @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  payments          Payment[]

  @@index([celebrityId])
  @@index([fanId])
  @@index([status])

  // A fan can hold at most ONE card per celebrity community. Enforced at the
  // database level so concurrent registrations can never create duplicates.
  @@unique([fanId, celebrityId])
}

// A payment for a fan card membership. Free levels can be issued without a
// Payment row; paid levels create a PENDING payment that becomes the fan card
// after it is marked PAID.
model Payment {
  id                String            @id @default(cuid())
  fanId             String
  cardId            String?
  celebrityId       String?
  membershipLevelId String?
  fan               Fan               @relation(fields: [fanId], references: [id], onDelete: Cascade)
  card              FanCard?          @relation(fields: [cardId], references: [id], onDelete: SetNull)
  celebrity         Celebrity?        @relation(fields: [celebrityId], references: [id], onDelete: SetNull)
  membershipLevel   MembershipLevel?  @relation(fields: [membershipLevelId], references: [id], onDelete: SetNull)
  amount            Float
  currency          String            @default("USD")
  status            String            @default("PENDING") // PENDING | PAID | FAILED | REFUNDED
  provider          String            @default("mock")    // mock | stripe | flutterwave | paypal | bank
  gatewayRef        String?           @unique // provider charge reference id — a charge can never settle twice
description       String?           // e.g. "Taylor Swift — Swiftie Gold"
  createdAt         DateTime          @default(now())
  paidAt            DateTime?

  bankTransferProofs BankTransferProof[]

@@index([fanId])
  @@index([status])
  @@index([cardId])
  @@index([celebrityId])
  @@index([membershipLevelId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Chat & messaging
// ─────────────────────────────────────────────────────────────────────────────

// The celebrities a fan chose in the "Choose Your Celebrities" onboarding step.
// A personalization list only — it grants no chat, payment or membership rights.
model FanCelebritySelection {
  id          String    @id @default(cuid())
  fanId       String
  celebrityId String
  fan         Fan       @relation(fields: [fanId], references: [id], onDelete: Cascade)
  celebrity   Celebrity @relation(fields: [celebrityId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([fanId, celebrityId])
  @@index([fanId])
  @@index([celebrityId])
}

// One chat room between a fan and one celebrity — exactly one row per
// (fan, celebrity) pair. The two "participants" are the bound actors; the
// celebrity side is operated by the celebrity's authorized team (or an
// official/system account) — the UI always labels that honestly.
model ChatConversation {
  id                 String    @id @default(cuid())
  fanId              String
  celebrityId        String
  status             String    @default("ACTIVE") // ACTIVE | BLOCKED_BY_FAN | BLOCKED_BY_TEAM | ARCHIVED
  mutedByFan         Boolean   @default(false)
  pinnedByFan        Boolean   @default(false)
  lastMessagePreview String?
  lastMessageAt      DateTime?
  lastMessageSender  String?   // "fan" | "team" | "system"
  fan                Fan       @relation(fields: [fanId], references: [id], onDelete: Cascade)
  celebrity          Celebrity @relation(fields: [celebrityId], references: [id], onDelete: Cascade)
  messages           ChatMessage[]
  readState          ChatReadState?
  reports            MessageReport[]
  calls              ChatCall[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([fanId, celebrityId])
  @@index([celebrityId])
  @@index([fanId])
}

// A chat message. `clientId` is the sender's locally generated id; the
// (conversationId, clientId) unique constraint makes retries idempotent, so a
// flaky connection can never create a duplicate message.
model ChatMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // Who wrote it: a fan, the celebrity's authorized team, or the system.
  senderType     String         // "fan" | "team" | "system"
  fanId          String?
  fan            Fan?           @relation(fields: [fanId], references: [id], onDelete: SetNull)
  teamEmail      String?        // admin email of the authorized team member (senderType = "team")
  clientId       String         // sender-generated unique id (dedupe)
  type           String         @default("text") // text | image | voice | video | call | system
  body           String         @default("")
  attachmentJson String?        // JSON: { bucket, key, mime, size, width?, height?, durationSec?, name? }
  status         String         @default("SENT") // PENDING | SENT | FAILED (server-side delivery state)
  deliveredAt    DateTime?
  readAt         DateTime?
  repliedToId    String?
  repliedTo      ChatMessage?   @relation("ChatReplies", fields: [repliedToId], references: [id], onDelete: SetNull)
  replies        ChatMessage[]  @relation("ChatReplies")
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  reports        MessageReport[]

  @@unique([conversationId, clientId])
  @@index([conversationId, createdAt])
}

// Watermark-based read receipts per conversation: the highest message time each
// participant has seen (or had delivered). Keeps read/delivered cheap and
// correct at any conversation size.
model ChatReadState {
  id               String          @id @default(cuid())
  conversationId   String          @unique
  conversation     ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  fanLastReadAt    DateTime?
  teamLastReadAt   DateTime?
  fanDeliveredUpTo DateTime?
  teamDeliveredUpTo DateTime?
  updatedAt        DateTime        @updatedAt
}

// A fan-initiated (or platform) block between a fan and one celebrity. While a
// block exists the fan cannot send messages — enforced on the server, never in
// the UI alone.
model ChatBlock {
  id          String    @id @default(cuid())
  fanId       String
  celebrityId String
  fan         Fan       @relation(fields: [fanId], references: [id], onDelete: Cascade)
  celebrity   Celebrity @relation(fields: [celebrityId], references: [id], onDelete: Cascade)
  reason      String?   // "none" | "spam" | "abuse" | "harassment" | "other"
  details     String?
  createdAt   DateTime  @default(now())

  @@unique([fanId, celebrityId])
  @@index([fanId])
  @@index([celebrityId])
}

// Fan- or team-reported content. Never auto-bans anyone — reports surface in
// the admin moderation view for a human decision.
model MessageReport {
  id             String          @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String?
  message        ChatMessage?    @relation(fields: [messageId], references: [id], onDelete: SetNull)
  reporterFanId  String?
  reporterFan    Fan?            @relation(fields: [reporterFanId], references: [id], onDelete: SetNull)
  reason         String
  details        String?
  status         String          @default("OPEN") // OPEN | REVIEWED | DISMISSED
  createdAt      DateTime        @default(now())

  @@index([status])
  @@index([conversationId])
  @@index([reporterFanId])
}

// Simple key/value app settings managed from the admin dashboard (e.g. the
// Gemini API key the AI celebrity scanner uses). The value is written only
// server-side; it is never returned to the client after being set.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// A source of publicly announced celebrity event information. Modular: one per
// provider (e.g. a live API, an official site, or the admin's manual entries).
// API credentials are ALWAYS read from backend env vars at runtime — never
// stored in plaintext in the DB and never shipped to the frontend.
model EventSource {
  id          String   @id @default(cuid())
  key         String   @unique // stable machine key, e.g. "admin", "ticketing-api"
  name        String
  enabled     Boolean  @default(true)
  kind        String   @default("manual") // manual | api | feed | import
  baseUrl     String?  // public provider endpoint or site (not secrets)
  configJson  String?  // non-secret config, e.g. options/endpoint params
  // Credential PLACEHOLDERS: we store only a flag + masked hint. The real value
  // must live in an env var referenced by envKey.
  envKey      String?  // name of the env var that holds the credential
  hasCredentials Boolean @default(false)
  description String?
  lastSyncAt  DateTime?
  lastSyncStatus String? // idle | running | ok | error
  lastSyncMessage String?
  // Ticket-inventory sync is tracked separately from event sync.
  supportsTickets Boolean @default(false)
  ticketsLastSyncAt DateTime?
  ticketsLastSyncStatus String?
  ticketsLastSyncMessage String?
  events      EventSourceLink[]
  ticketInventory TicketInventory[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Many-to-many link between a celebrity event and its source(s). Lets us
// dedupe the same event discovered from multiple providers and preserve the
// original public source URL per discovery.
model EventSourceLink {
  id        String      @id @default(cuid())
  eventId   String
  sourceId  String
  externalId String?    // provider's own id for this event (used for matching)
  sourceUrl String?     // original public source/listing URL
  rawJson   String?     // raw payload snapshot from the provider (for re-sync)
  event     CelebrityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  source    EventSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  firstSeenAt DateTime  @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([eventId, sourceId])
  @@index([sourceId])
  @@index([externalId])
}

// A publicly announced celebrity event. Only public information is stored.
model CelebrityEvent {
  id             String   @id @default(cuid())
  eventId        String   @unique // unique internal id, e.g. "evt_xxxx"
  celebrityId    String
  celebrity      Celebrity @relation(fields: [celebrityId], references: [id], onDelete: Cascade)

  name           String
  type           String   @default("Public appearance") // Concert | Tour | ... | Other
  description    String?

  venue          String?
  city           String?
  region         String?
  country        String?

  // Public announced timing. startAt is the authoritative start moment; endAt
  // optional. All stored as UTC instants; timezone is the public venue tz name
  // (e.g. "America/New_York") used for correct local countdowns/display.
  startAt        DateTime
  endAt          DateTime?
  timezone       String?  // IANA tz name of the venue/public listing
  allDay         Boolean  @default(false)

  status         String   @default("UPCOMING") // UPCOMING | HAPPENING_NOW | COMPLETED | POSTPONED | CANCELLED
  // Administrative override for postponements/cancellations; the live status is
  // derived from override (if set) else computed from startAt/endAt.
  statusOverride String?  // POSTPONED | CANCELLED | null

  officialUrl    String?  // official event page (if public)
  ticketUrl      String?  // official ticket link (if public) — never fabricated
  sourceUrl      String?  // original public source URL

  verification   String   @default("UNVERIFIED") // UNVERIFIED | VERIFIED | UPDATED | CANCELLED | POSTPONED
  verifiedBy     String?  // "admin" etc.
  verifiedAt     DateTime?

  // Free registration settings
  registrationEnabled  Boolean  @default(false)
  maxRegistrations     Int?     // null = unlimited
  registrationCount    Int      @default(0)

  // Free QR tickets enabled (set true to allow fans to register + get QR tickets)
  ticketsEnabled       Boolean  @default(false)
  socialAutoPost       Boolean  @default(true) // eligible for automatic social posting

  sources        EventSourceLink[]
  updates        EventUpdate[]
  ticketInventory TicketInventory[]
  ticketOrders   TicketOrder[]
  registrations  EventRegistration[]
  lastSyncedAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([celebrityId])
  @@index([status])
  @@index([startAt])
  @@index([verification])
}

// A fan registration for a free event ticket with QR code.
model EventRegistration {
  id            String   @id @default(cuid())
  eventId       String
  event         CelebrityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderId       String?  // linked TicketOrder if created via checkout
  order         TicketOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  name          String
  email         String
  phone         String?
  country       String?

  ticketCode    String   @unique // unique ticket identifier, e.g. TKT-xxxx
  ticketQrData  String   // data encoded in the QR code
  checkedIn     Boolean  @default(false)
  checkedInAt   DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([eventId])
  @@index([email])
  @@index([ticketCode])
  @@index([eventId, email])
}

// Audit trail: every meaningful status/verification change on an event.
model EventUpdate {
  id        String  @id @default(cuid())
  eventId   String
  event     CelebrityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  field     String       // e.g. "status", "startAt", "verification"
  fromValue String?
  toValue   String?
  note      String?
  source    String?       // e.g. "sync", "admin"
  createdAt DateTime @default(now())

  @@index([eventId])
}
// ===========================================================================
// TICKETING (public events -> ticket availability -> order -> payment -> ticket)
// ---------------------------------------------------------------------------
// Real ticket inventory is ONLY ever written by the ticket-source sync engine
// from authorized providers. Nothing here can fabricate availability or prices.
// ===========================================================================

// One row = one ticket type / price point offered for a public event, as
// reported by an authorized ticket source. Read-only from the app's point of
// view: only the sync engine writes it.
model TicketInventory {
  id                String          @id @default(cuid())
  eventId           String
  event             CelebrityEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sourceId          String? // which EventSource reported this (never edited by hand)
  source            EventSource?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  externalId        String? // provider's own id for this ticket type (dedupe)
  name              String // e.g. "General Admission", "VIP"
  category          String? // section / tier when the source provides it
  priceCents        Int
  feesCents         Int             @default(0) // fees as reported by the source
  currency          String          @default("USD")
  quantityAvailable Int? // null = source does not disclose
  quantityTotal     Int?
  status            String          @default("AVAILABLE") // AVAILABLE | LIMITED | SOLD_OUT | NOT_YET_ON_SALE | UNAVAILABLE
  url               String? // provider-authorized deep link to buy this ticket type
  displayAuthorized Boolean         @default(true) // false = source forbids us to show details
  saleStartAt       DateTime?
  saleEndAt         DateTime?
  lastSyncedAt      DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  orderItems        TicketOrderItem[]

  @@index([eventId])
  @@index([sourceId])
  @@index([status])
  @@index([eventId, status])
}

// A real purchase intent (and later, a real sale). A ticket/confirmation is
// NEVER generated until payment has actually succeeded.
model TicketOrder {
  id                String              @id @default(cuid())
  orderRef          String              @unique // consumer-facing ref, e.g. TCK-xxxx
  accessToken       String // secret access token for the holder to view/manage this order
  fanId             String?
  fan               Fan?                @relation(fields: [fanId], references: [id], onDelete: SetNull)
  eventId           String
  event             CelebrityEvent      @relation(fields: [eventId], references: [id], onDelete: Restrict)
  paymentMethodId   String?
  paymentMethod     PaymentMethod?      @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  customerName      String
  customerEmail     String
  customerPhone     String?
  customerCountry   String?

  subtotalCents     Int
  feesCents         Int
  totalCents        Int
  currency          String              @default("USD")

  status            String              @default("PENDING_PAYMENT") // PENDING_PAYMENT | PAYMENT_PROCESSING | CONFIRMED | FAILED | CANCELLED | REFUNDED
  paymentStatus     String              @default("UNPAID") // UNPAID | PROCESSING | PAID | FAILED | REFUNDED
  paidAt            DateTime?
  amountPaidCents   Int?
  paymentProvider   String? // gateway key after a real gateway is connected
  paymentRef        String? @unique // real gateway charge ref — a charge can never back two orders
  officialRef       String? // authorized ticket source's own order/ticket ref (only after success)
  deliveryMethod    String? // DIGITAL | MOBILE | DOWNLOAD | OFFICIAL_ACCOUNT
  deliveryDetail    String?
  notes             String?
  statusHistoryJson String? // array of {status, at, note} snapshots

  // QR ticket code (set when order is confirmed for free registration)
  ticketCode        String?  @unique

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

items         TicketOrderItem[]
  transactions  TicketTransaction[]
  bankTransferProofs BankTransferProof[]
  registrations EventRegistration[]

  @@index([eventId])
  @@index([status])
  @@index([fanId])
  @@index([customerEmail])
  @@index([createdAt])
}

model TicketOrderItem {
  id            String          @id @default(cuid())
  orderId       String
  order         TicketOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventoryId   String?
  inventory     TicketInventory? @relation(fields: [inventoryId], references: [id], onDelete: SetNull)
  eventId       String
  ticketName    String // frozen snapshot at order time
  category      String?
  quantity      Int
  unitPriceCents Int
  feesEachCents Int             @default(0)
  subtotalCents Int
  currency      String          @default("USD")

  @@index([orderId])
  @@index([inventoryId])
}

// Every money-movement attempt is recorded. SUCCEEDED only happens with a real
// gateway / real refund; nothing is ever marked succeeded without a transaction.
model TicketTransaction {
  id          String   @id @default(cuid())
  orderId     String
  order       TicketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind        String   @default("PAYMENT") // PAYMENT | REFUND
  status      String   @default("INITIATED") // INITIATED | PROCESSING | SUCCEEDED | FAILED
  amountCents Int
  currency    String   @default("USD")
  provider    String?  // gateway key once connected
  providerRef String?  // real gateway ref
  message     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderId])
  @@index([status])
}

// Payment methods a customer can pick at checkout, and the admin's settlement
// account. Credentials ALWAYS live in backend env vars (envKey reference only),
// never in the DB and never in frontend JS.
model PaymentMethod {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "card", "bank-transfer"
  name        String
  kind        String   @default("CARD") // CARD | BANK_TRANSFER | WALLET
  isEnabled   Boolean  @default(false)
  isDefault   Boolean  @default(false)
  currency    String   @default("USD")
  // Env var names that must hold this gateway's real credentials (never values).
  credentialEnvKeysJson String? // JSON array of env var names
  hasCredentials Boolean @default(false)
  configJson  String?  // non-secret options
  // Settlement: the admin's own business account for receiving ticket funds.
  settlementAccountLabel String?
  settlementAccountLast4 String?
  settlementAccountEnvKey String? // env var that holds the real account/detail
  hasSettlementAccount Boolean @default(false)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      TicketOrder[]
  settlements SettlementRecord[]

  @@index([isEnabled])
}

// A bank account that customers pay into for Bank Transfer orders. Fully
// admin-managed so the admin can add/remove countries and change details.
// Displayed to the customer in a realistic bank-app-style card in checkout.
model BankAccount {
  id            String   @id @default(cuid())
  currency      String   @unique // e.g. "USD", "EUR", "GBP" (upper-case code)
  countryName   String   // human label, e.g. "United States"
  countryFlag   String?  // emoji or short label, e.g. "🇺🇸"
  beneficiary   String   // account holder shown to customer
  bankName      String
  accountType   String?  // CHECKING / Savings (where applicable)
  // Currency-specific identifiers (all optional; only the ones that apply are set).
  accountNumber String?
  iban          String?
  bic           String?
  swift         String?
  routing       String?  // ABA (USD)
  sortCode      String?  // UK
  institutionNumber String? // CA
  transitNumber String?  // CA
  branchCode     String? // BSB/AU, JPY branch, etc.
  bankCode      String?  // JPY/SG/MX etc.
  transferType  String   @default("Local transfer")
  bankAddress   String?
  isActive      Boolean  @default(true)
  displayOrder  Int      @default(0)
  // Optional: an env-var NAME that holds an account-level detail (never the value).
  envKeyRef     String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bankTransferProofs BankTransferProof[]

  @@index([isActive])
  @@index([currency])
}

// A proof a customer submitted for a Bank Transfer payment. Until it is
// VERIFIED by an admin the associated payment stays Pending Verification (never
// marked paid from the customer's own submission alone).
model BankTransferProof {
  id          String        @id @default(cuid())
  paymentMethodId String?    // link to the "bank-transfer" method row if present
  bankAccountId String?
  bankAccount  BankAccount?  @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  amountCents  Int
  currency     String        @default("USD")
  senderName   String?       // name on the customer's transfer
  reference    String?       // reference/MTA the customer entered
  transferDate DateTime?     // when the customer says they transferred
  fileName     String?       // stored proof filename
  fileUrl      String?       // where the proof is stored
  mimeType     String?
  status       String        @default("PENDING_VERIFICATION") // PENDING_VERIFICATION | APPROVED | REJECTED
  adminNote    String?
  // Which purchase this proof applies to. Only ONE of the two is set.
  paymentId    String?       // fans-card Payment (if it's a card purchase)
  payment      Payment?      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  ticketOrderId String?      // ticket order (if it's a ticket purchase)
  ticketOrder  TicketOrder?  @relation(fields: [ticketOrderId], references: [id], onDelete: Cascade)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([paymentId])
  @@index([ticketOrderId])
  @@index([bankAccountId])
}

// A support/contact request submitted through the public Contact & Support form.
// Stored server-side so the team can review and respond. Never publicly exposed.
model SupportRequest {
  id          String   @id @default(cuid())
  name        String?
  email       String
  category    String   @default("General") // General | Account | Payments | Tickets | Privacy | Security | Other
  subject     String?
  message     String
  reference   String? // optional account/order/ticket reference the user provides
  status      String   @default("NEW") // NEW | IN_PROGRESS | RESOLVED | CLOSED
  sourceIp    String?
  userAgent   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

// A data-subject request (access / correction / deletion / export) submitted
// through the User Rights & Data Requests page. Stored so staff can act on it.
model DataRequest {
  id          String   @id @default(cuid())
  email       String
  requestType String   // ACCESS | CORRECTION | DELETION | EXPORT
  description String?
  name        String?
  reference   String?
  status      String   @default("RECEIVED") // RECEIVED | IN_PROGRESS | COMPLETED | REJECTED
  sourceIp    String?
  userAgent   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

// A one-time password reset token issued to a fan for the password-reset flow.
// Tokens are hashed at rest and expire.
model PasswordResetToken {
  id        String   @id @default(cuid())
  fanId     String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([fanId])
  @@index([expiresAt])
}

// Operational settlement records entered by the admin from REAL settlement
// statements. Amounts are the admin's bookkeeping of actual money received.
model SettlementRecord {
  id              String        @id @default(cuid())
  paymentMethodId String
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)
  periodStart     DateTime?
  periodEnd       DateTime?
  amountCents     Int
  currency        String        @default("USD")
  status          String        @default("RECORDED") // RECORDED | CLEARED | DISPUTED
  reference       String?       // admin-entered real settlement/report reference
  note            String?
  createdAt       DateTime      @default(now())

  @@index([paymentMethodId])
}

// ===========================================================================
// SOCIAL MEDIA PUBLISHING (Marketing / Social Media Automation)
// ---------------------------------------------------------------------------
// Admin-only. Real credentials and access tokens NEVER live in frontend code:
//   - Platform app credentials come from server-side env vars (referenced by
//     name only in SocialPlatform.credentialEnvKeysJson).
//   - Access/refresh tokens are encrypted at rest with AES-256-GCM using the
//     SOCIAL_TOKEN_ENCRYPTION_KEY env var and are never returned to the client.
// The SocialPlatform rows are seeded once and managed from the admin dashboard.
// ===========================================================================

// One row per supported platform (TikTok, Telegram, WhatsApp, Facebook,
// Instagram, YouTube, X, Pinterest, LinkedIn). Seeded, not user-created.
model SocialPlatform {
  id            String   @id @default(cuid())
  key           String   @unique // tiktok | telegram | whatsapp | facebook | instagram | youtube | x | pinterest | linkedin
  name          String
  color         String   @default("#8b5cf6")
  icon          String?  // short glyph/label used by UI accents
  supportsText  Boolean  @default(true)
  supportsImage Boolean  @default(true)
  supportsVideo Boolean  @default(false)
  // OAuth based platforms need app approval / business verification before
  // content posting works. This flags what the admin dashboard must show.
  requiresApproval Boolean @default(false)
  approvalStatus String   @default("not_required") // not_required | required | pending | approved | denied
  approvalNote  String?   // human message explaining the requirement
  authUrl       String?   // official OAuth authorize endpoint (null = token-entry, e.g. Telegram bot)
  tokenUrl      String?   // official token exchange endpoint
  credentialEnvKeysJson String? // JSON array of env var names that hold app credentials (never values)
  hasCredentials Boolean  @default(false)
  scopesJson    String?   // JSON array of required OAuth scopes
  enabled       Boolean   @default(true)
  apiStatus     String    @default("not_configured") // not_configured | configured | needs_approval | degraded | error | ok
  apiNote       String?
  displayOrder  Int       @default(0)
  accounts      SocialAccount[]
  schedules     SocialSchedule[]
  queueItems    SocialQueueItem[]
  posts         SocialPost[]
  logs          SocialPostLog[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([enabled])
  @@index([apiStatus])
}

// A connected social account owned by the admin. Tokens are encrypted at rest.
model SocialAccount {
  id                  String          @id @default(cuid())
  platformKey         String
  platform            SocialPlatform  @relation(fields: [platformKey], references: [key], onDelete: Cascade)
  externalUserId      String?         // provider's user/platform id
  externalUsername    String?         // handle shown in the dashboard
  externalUrl         String?
  accountType         String?         // influencer | business | page | bot | channel
  scopes              String?         // JSON array of granted scopes
  tokenEncrypted      String?         // AES-256-GCM "iv.tag.data" (never plaintext)
  refreshTokenEncrypted String?
  tokenExpiresAt      DateTime?
  tokenIssuedAt       DateTime?
  isConnected         Boolean         @default(true)
  status              String          @default("connected") // connected | expired | needs_refresh | invalid | revoked
  lastError           String?
  lastCheckedAt       DateTime?
  rawProfileJson      String?         // cached profile snapshot (no tokens)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  queueItems          SocialQueueItem[]
  posts               SocialPost[]

  @@index([platformKey])
  @@index([status])
}

// Singleton global automation configuration (one row, id always 1).
model SocialConfig {
  id              Int      @id @default(1)
  automationEnabled Boolean @default(false) // master switch for automatic posting
  paused          Boolean  @default(false)  // pause all automation (resume = false)
  approvalMode    String   @default("auto") // auto = publish immediately | approval = hold for admin approval
  maxPostsPerDay  Int      @default(10)     // global daily cap per platform
  maxRetries      Int      @default(3)
  retryBackoffMinutes Int  @default(30)     // base backoff before retrying a failed post
  dedupeWindowDays Int     @default(30)     // prevent re-posting the same content within N days
  contentTypesJson String  @default("[\"celebrity\",\"membership\",\"event\",\"article\",\"promo\"]")
  updatedAt       DateTime @updatedAt
}

// One posting schedule per platform (the "Automatic posting" engine driver).
model SocialSchedule {
  id            String          @id @default(cuid())
  platformKey   String
  platform      SocialPlatform  @relation(fields: [platformKey], references: [key], onDelete: Cascade)
  name          String?         // admin label
  enabled       Boolean         @default(false)
  contentTypesJson String       @default("[]") // subset of content types this schedule posts
  frequency     String          @default("daily") // hourly | daily | weekly | custom
  intervalMinutes Int?          // for hourly / custom frequencies
  timesJson     String          @default("[]") // e.g. ["09:00","18:00"] — HH:MM in UTC
  weekdaysJson  String?         // for weekly, e.g. [1,3,5] (1=Monday)
  maxPerDay     Int?            // per-schedule cap, overrides global maxPostsPerDay
  nextRunAt     DateTime?       // next time the engine scans for new content
  lastRunAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([platformKey])
  @@index([enabled])
}

// A single item in the publishing pipeline (automatic or manual).
model SocialQueueItem {
  id            String          @id @default(cuid())
  contentKey    String          // dedupe key, e.g. "membership:clxyz" | "promo:abc" | "article:clxyz"
  platformKey   String
  platform      SocialPlatform  @relation(fields: [platformKey], references: [key], onDelete: Cascade)
  accountId     String?
  account       SocialAccount?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contentType   String          // celebrity | membership | event | article | promo
  contentRefId  String?         // id of the source entity
  title         String
  caption       String?
  mediaJson     String?         // JSON array of assets {url, mimeType, name} or asset ids
  linkUrl       String?
  source        String          @default("AUTO") // AUTO | MANUAL | PROMO
  status        String          @default("QUEUED") // DRAFT | QUEUED | SCHEDULED | APPROVAL_REQUIRED | PROCESSING | PUBLISHED | FAILED | CANCELLED | SKIPPED
  scheduledFor  DateTime?
  attempts      Int             @default(0)
  maxAttempts   Int             @default(3)
  nextAttemptAt DateTime?
  lastError     String?
  externalPostId String?
  externalUrl   String?
  publishedAt   DateTime?
  dedupeHash    String?         // content fingerprint for repeat-content prevention
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  logs          SocialPostLog[]

  @@unique([contentKey, platformKey])
  @@index([status])
  @@index([platformKey])
  @@index([scheduledFor])
  @@index([contentType])
}

// Published (or fully attempted) posts, one row per successful/failed publish.
model SocialPost {
  id            String          @id @default(cuid())
  queueItemId   String?
  platformKey   String
  platform      SocialPlatform  @relation(fields: [platformKey], references: [key], onDelete: Cascade)
  accountId     String?
  account       SocialAccount?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  title         String
  caption       String?
  mediaJson     String?
  linkUrl       String?
  contentType   String?
  source        String          @default("MANUAL") // AUTO | MANUAL | PROMO
  externalPostId String?
  externalUrl   String?
  status        String          @default("PUBLISHED") // PUBLISHED | FAILED | SKIPPED
  error         String?         // final error when FAILED
  publishedAt   DateTime?
  createdAt     DateTime        @default(now())

  @@index([platformKey])
  @@index([status])
  @@index([publishedAt])
}

// Append-only audit log of every publish attempt, success and failure.
model SocialPostLog {
  id            String           @id @default(cuid())
  queueItemId   String?
  queueItem     SocialQueueItem? @relation(fields: [queueItemId], references: [id], onDelete: SetNull)
  platformKey   String
  platform      SocialPlatform   @relation(fields: [platformKey], references: [key], onDelete: Cascade)
  postId        String?
  level         String           @default("info") // info | success | warn | error
  message       String
  detail        String?          // API snapshot WITHOUT tokens
  status        String?          // related queue status at log time
  createdAt     DateTime         @default(now())

  @@index([queueItemId])
  @@index([platformKey])
  @@index([postId])
  @@index([createdAt])
}

// Marketplace news/articles that can be auto-published to social accounts.
model SocialArticle {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  summary       String?
  body          String?
  author        String?
  category      String   @default("News")
  coverImage    String?  // URL or data URI
  status        String   @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  autoPostEnabled Boolean @default(true) // eligible for automatic social posting
  linkedCelebrityId String?
  linkedCelebrity Celebrity? @relation(fields: [linkedCelebrityId], references: [id], onDelete: SetNull)
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([publishedAt])
}

// Uploaded or referenced media attached to posts.
model SocialMediaAsset {
  id          String   @id @default(cuid())
  fileName    String?
  mimeType    String?
  sizeBytes   Int?
  storage     String   @default("db") // db (inline data URI) | url
  dataUri     String?  // inline base64 data when stored in db
  url         String?  // external URL when referenced
  platformKey String?
  createdAt   DateTime @default(now())
}

// CSRF-safe OAuth state rows so the callback can verify the flow originated
// from this dashboard.
model SocialOAuthState {
  id          String   @id @default(cuid())
  state       String   @unique
  platformKey String
  redirectTo  String?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([state])
  @@index([expiresAt])
}

// ===========================================================================
// EMAIL & NOTIFICATION SYSTEM
// ---------------------------------------------------------------------------
// A persistent email queue. Every customer-facing email is written here first
// (with a unique `dedupeKey` so the same message can never be queued twice),
// then a background worker sends it in small batches with automatic retries
// (up to `maxAttempts`) and records delivery status from provider webhooks.
// ---------------------------------------------------------------------------

// One queued/sent email message. `dedupeKey` (e.g. "welcome:<fanId>") is the
// idempotency guard: calling enqueueEmail twice for the same event returns the
// original row instead of creating a second email.
model EmailMessage {
  id                String   @id @default(cuid())
  fanId             String?
  fan               Fan?     @relation(fields: [fanId], references: [id], onDelete: SetNull)
  announcementId    String?
  announcement      EmailAnnouncement? @relation(fields: [announcementId], references: [id], onDelete: SetNull)
  dedupeKey         String   @unique
  type              String   // WELCOME | EMAIL_VERIFICATION | PASSWORD_RESET | PAYMENT_RECEIPT | CARD_ACTIVATED | NEW_CELEBRITY | UPDATE | COMMUNITY | PROMOTION
  to                String
  from              String?
  subject           String
  template          String
  htmlBody          String   @db.Text
  status            String   @default("PENDING") // PENDING | SENDING | SENT | DELIVERED | OPENED | FAILED | PERMANENT_FAILED | CANCELED
  attempts          Int      @default(0)
  maxAttempts       Int      @default(3)
  nextAttemptAt     DateTime @default(now())
  lastError         String?
  providerMessageId String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  openedAt          DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([fanId])
  @@index([announcementId])
  @@index([providerMessageId])
  @@index([createdAt])
}

// An admin-defined broadcast. `audienceConfigJson` holds the selector for the
// chosen audience type; the worker fans eligible recipients out as individual
// EmailMessage rows (batch-insered, one per fan).
model EmailAnnouncement {
  id                 String   @id @default(cuid())
  title              String
  audienceType       String   // ALL_SUBSCRIBED | NEW_CELEBRITY | CELEBRITY_FANS | MEMBERSHIP_LEVEL | COUNTRY | SPECIFIC_FANS
  audienceConfigJson String?
  template           String   // NEW_CELEBRITY | UPDATE | COMMUNITY | PROMOTION
  celebrityId        String?
  celebrity          Celebrity? @relation(fields: [celebrityId], references: [id], onDelete: SetNull)
  subject            String
  htmlBody           String?  @db.Text // rendered at send time so it is always current
  status             String   @default("DRAFT") // DRAFT | SENDING | SENT | CANCELED
  targetsCount       Int      @default(0)
  enqueuedCount      Int      @default(0)
  sentCount          Int      @default(0)
  failedCount        Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  messages           EmailMessage[]

  @@index([status])
  @@index([createdAt])
}

// One-time email-verification tokens (hashed at rest, like password resets).
model EmailVerificationToken {
  id        String   @id @default(cuid())
  fanId     String
  fan       Fan      @relation(fields: [fanId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([fanId])
  @@index([expiresAt])
}

// Idempotency ledger for incoming provider webhooks. A provider event ID is
// stored here once; if the provider retries/delivers the same event twice the
// duplicate is ignored. Replaces per-provider webhook fetch logic.
model WebhookEvent {
  id         String   @id @default(cuid())
  provider   String   // e.g. "resend"
  eventId    String   @unique
  type       String?
  payload    String?  @db.Text
  receivedAt DateTime @default(now())
  handledAt  DateTime?

  @@index([provider])
  @@index([receivedAt])
}
