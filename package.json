{
  "name": "fancard-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma migrate deploy && prisma generate && node prisma/apply-premium-levels.mjs && node prisma/set-base-memberships.mjs && node prisma/assign-fan-counts.mjs && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:setup": "prisma generate && prisma db push && node prisma/seed.mjs && node prisma/set-base-memberships.mjs && node prisma/assign-fan-counts.mjs",
    "premium:apply": "node prisma/apply-premium-levels.mjs",
    "base:apply": "node prisma/set-base-memberships.mjs",
    "events:seed": "node prisma/seed-events.mjs",
    "events:sync": "node scripts/sync-events.mjs",
    "tickets:sync": "node scripts/sync-tickets.mjs",
    "bank:seed": "node scripts/seed-bank-accounts.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/push-notifications": "^8.1.2",
    "@prisma/client": "^6.19.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "next": "16.3.4",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
