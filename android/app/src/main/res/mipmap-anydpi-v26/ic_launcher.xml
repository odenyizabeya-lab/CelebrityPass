<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive launcher icon (Android 8.0+ / API 26+).

    The <monochrome> layer is what Android 13+ uses for themed icons, where the
    launcher re-tints the alpha channel with the user's wallpaper palette. It is
    ignored on API 26-32, so it is safe to declare in this anydpi-v26 folder.

    Background: the violet -> magenta brand gradient, full bleed.
    Foreground: the white star + amber stripe, kept inside the 72dp safe zone
    (the star renders ~49dp wide) so no launcher mask clips its points.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>
